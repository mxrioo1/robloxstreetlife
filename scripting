UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.F8 then
        Frame.Visible = not Frame.Visible
    end
end)

ToggleBtn.MouseButton1Click:Connect(function()
    Settings.Enabled = not Settings.Enabled
    if Settings.Enabled then
        ToggleBtn.Text = "SILENT: ON"
        ToggleBtn.TextColor3 = Color3.fromRGB(0, 255, 120)
    else
        ToggleBtn.Text = "SILENT: OFF"
        ToggleBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    end
end)

StrengthBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseWheel then
        Settings.Strength = math.clamp(Settings.Strength + input.Position.Z * 0.1, 0.1, 1.0)
        StrengthFill.Size = UDim2.new(Settings.Strength, 0, 1, 0)
    end
end)

local dragging = false
local dragStart = nil
local startPos = nil

Frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = Frame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        Frame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)
