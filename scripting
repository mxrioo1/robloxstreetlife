-- ratman4080 aimbot v1 | Claude Style UI
-- Camera Aimbot | FOV Circle | Color Picker | Right-Click to Aim

local success, err = pcall(function()
    print("sit activated")

    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService")
    local Workspace = game:GetService("Workspace")

    local LocalPlayer = Players.LocalPlayer
    local Camera = Workspace.CurrentCamera

    getgenv().Settings = getgenv().Settings or { 
        Enabled = false, 
        FOV = 120, 
        Smoothness = 0.35,
        Color = Color3.fromRGB(88, 166, 255),
        IsAiming = false
    }
    local Settings = getgenv().Settings
    local isDead = false

    -- 监听鼠标状态
    UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then Settings.IsAiming = true end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then Settings.IsAiming = false end
    end)

    -- UI 父级
    local guiParent = (gethui and gethui()) or game:GetService("CoreGui")

    -- ============================================================
    -- 1. 屏幕中心 FOV 圈
    -- ============================================================
    local FOVGui = Instance.new("ScreenGui")
    FOVGui.Name = "4080_FOV"
    FOVGui.ResetOnSpawn = false
    FOVGui.Parent = guiParent

    local FOVCircle = Instance.new("Frame")
    FOVCircle.Size = UDim2.new(0, Settings.FOV * 2, 0, Settings.FOV * 2)
    FOVCircle.Position = UDim2.new(0.5, 0, 0.5, 0)
    FOVCircle.AnchorPoint = Vector2.new(0.5, 0.5)
    FOVCircle.BackgroundTransparency = 1
    FOVCircle.Parent = FOVGui

    local FOVCorner = Instance.new("UICorner")
    FOVCorner.CornerRadius = UDim.new(1, 0)
    FOVCorner.Parent = FOVCircle

    local FOVStroke = Instance.new("UIStroke")
    FOVStroke.Color = Settings.Color
    FOVStroke.Thickness = 1.5
    FOVStroke.Parent = FOVCircle

    -- ============================================================
    -- 2. 核心 Aimbot 逻辑 (RenderStepped)
    -- ============================================================
    local function getClosestTarget()
        if not Camera then return nil end
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local closest, bestDist = nil, math.huge

        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer or (player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team) then continue end
            local char = player.Character
            if not char then continue end
            
            local head = char:FindFirstChild("HitboxHead") or char:FindFirstChild("Head")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not head or not hum or hum.Health <= 0 then continue end

            local sp, onScreen = Camera:WorldToViewportPoint(head.Position)
            if not onScreen then continue end

            local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
            if dist < bestDist and dist < Settings.FOV then
                bestDist = dist
                closest = head.Position
            end
        end
        return closest
    end

    RunService.RenderStepped:Connect(function(dt)
        if isDead or not Settings.Enabled or not Settings.IsAiming then return end
        
        local targetPos = getClosestTarget()
        if targetPos and Camera then
            -- 计算看向目标的 CFrame
            local aimCFrame = CFrame.lookAt(Camera.CFrame.Position, targetPos)
            -- 使用 Smoothness 参数进行插值，越大锁得越快
            Camera.CFrame = Camera.CFrame:Lerp(aimCFrame, Settings.Smoothness)
        end
    end)

    -- ============================================================
    -- 3. Claude 风格超大 UI (350x350)
    -- ============================================================
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "4080_Aimbot_UI"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = guiParent
    
    local MainFrame = Instance.new("Frame")
    MainFrame.Size = UDim2.new(0, 350, 0, 310)
    MainFrame.Position = UDim2.new(0.5, -175, 0.5, -155)
    MainFrame.BackgroundColor3 = Color3.fromRGB(22, 22, 26) -- #16161A
    MainFrame.BorderSizePixel = 0
    MainFrame.Visible = false
    MainFrame.Parent = ScreenGui
    
    local MainCorner = Instance.new("UICorner")
    MainCorner.CornerRadius = UDim.new(0, 14)
    MainCorner.Parent = MainFrame
    
    local MainStroke = Instance.new("UIStroke")
    MainStroke.Color = Color3.fromRGB(45, 45, 52)
    MainStroke.Thickness = 1
    MainStroke.Parent = MainFrame

    -- Header
    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, -32, 0, 28)
    Title.Position = UDim2.new(0, 16, 0, 16)
    Title.BackgroundTransparency = 1
    Title.Text = "4080 · AIMBOT"
    Title.TextColor3 = Color3.fromRGB(235, 235, 240)
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 18
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = MainFrame
    
    local Subtitle = Instance.new("TextLabel")
    Subtitle.Size = UDim2.new(1, -32, 0, 16)
    Subtitle.Position = UDim2.new(0, 16, 0, 44)
    Subtitle.BackgroundTransparency = 1
    Subtitle.Text = "Hold Right Click to lock onto target"
    Subtitle.TextColor3 = Color3.fromRGB(140, 140, 150)
    Subtitle.Font = Enum.Font.Gotham
    Subtitle.TextSize = 12
    Subtitle.TextXAlignment = Enum.TextXAlignment.Left
    Subtitle.Parent = MainFrame
    
    local Div = Instance.new("Frame")
    Div.Size = UDim2.new(1, -32, 0, 1)
    Div.Position = UDim2.new(0, 16, 0, 70)
    Div.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
    Div.BorderSizePixel = 0
    Div.Parent = MainFrame

    -- Toggle Button
    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Size = UDim2.new(1, -32, 0, 42)
    ToggleBtn.Position = UDim2.new(0, 16, 0, 86)
    ToggleBtn.BackgroundColor3 = Settings.Enabled and Color3.fromRGB(28, 45, 70) or Color3.fromRGB(32, 32, 38)
    ToggleBtn.Text = Settings.Enabled and "AIMBOT : ON" or "AIMBOT : OFF"
    ToggleBtn.TextColor3 = Settings.Enabled and Color3.fromRGB(88, 166, 255) or Color3.fromRGB(180, 180, 190)
    ToggleBtn.Font = Enum.Font.GothamSemibold
    ToggleBtn.TextSize = 13
    ToggleBtn.BorderSizePixel = 0
    ToggleBtn.Parent = MainFrame
    
    local ToggleCorner = Instance.new("UICorner")
    ToggleCorner.CornerRadius = UDim.new(0, 8)
    ToggleCorner.Parent = ToggleBtn

    -- FOV Slider
    local FOVLabel = Instance.new("TextLabel")
    FOVLabel.Size = UDim2.new(0, 80, 0, 16)
    FOVLabel.Position = UDim2.new(0, 16, 0, 146)
    FOVLabel.BackgroundTransparency = 1
    FOVLabel.Text = "FOV SIZE"
    FOVLabel.TextColor3 = Color3.fromRGB(130, 130, 140)
    FOVLabel.Font = Enum.Font.GothamBold
    FOVLabel.TextSize = 11
    FOVLabel.TextXAlignment = Enum.TextXAlignment.Left
    FOVLabel.Parent = MainFrame

    local FOVTrack = Instance.new("Frame")
    FOVTrack.Size = UDim2.new(0, 200, 0, 8)
    FOVTrack.Position = UDim2.new(0, 110, 0, 150)
    FOVTrack.BackgroundColor3 = Color3.fromRGB(40, 40, 46)
    FOVTrack.BorderSizePixel = 0
    FOVTrack.Parent = MainFrame
    
    local FOVTrackCorner = Instance.new("UICorner")
    FOVTrackCorner.CornerRadius = UDim.new(0, 4)
    FOVTrackCorner.Parent = FOVTrack

    local FOVFill = Instance.new("Frame")
    FOVFill.Size = UDim2.new((Settings.FOV - 20) / 280, 0, 1, 0) -- 假设 FOV 范围 20 到 300
    FOVFill.BackgroundColor3 = Color3.fromRGB(88, 166, 255)
    FOVFill.BorderSizePixel = 0
    FOVFill.Parent = FOVTrack
    
    local FOVFillCorner = Instance.new("UICorner")
    FOVFillCorner.CornerRadius = UDim.new(0, 4)
    FOVFillCorner.Parent = FOVFill

    -- Smoothness Slider
    local SmoothLabel = Instance.new("TextLabel")
    SmoothLabel.Size = UDim2.new(0, 80, 0, 16)
    SmoothLabel.Position = UDim2.new(0, 16, 0, 176)
    SmoothLabel.BackgroundTransparency = 1
    SmoothLabel.Text = "SMOOTHNESS"
    SmoothLabel.TextColor3 = Color3.fromRGB(130, 130, 140)
    SmoothLabel.Font = Enum.Font.GothamBold
    SmoothLabel.TextSize = 11
    SmoothLabel.TextXAlignment = Enum.TextXAlignment.Left
    SmoothLabel.Parent = MainFrame

    local SmoothTrack = Instance.new("Frame")
    SmoothTrack.Size = UDim2.new(0, 200, 0, 8)
    SmoothTrack.Position = UDim2.new(0, 110, 0, 180)
    SmoothTrack.BackgroundColor3 = Color3.fromRGB(40, 40, 46)
    SmoothTrack.BorderSizePixel = 0
    SmoothTrack.Parent = MainFrame
    
    local SmoothTrackCorner = Instance.new("UICorner")
    SmoothTrackCorner.CornerRadius = UDim.new(0, 4)
    SmoothTrackCorner.Parent = SmoothTrack

    local SmoothFill = Instance.new("Frame")
    SmoothFill.Size = UDim2.new(Settings.Smoothness, 0, 1, 0)
    SmoothFill.BackgroundColor3 = Color3.fromRGB(88, 166, 255)
    SmoothFill.BorderSizePixel = 0
    SmoothFill.Parent = SmoothTrack
    
    local SmoothFillCorner = Instance.new("UICorner")
    SmoothFillCorner.CornerRadius = UDim.new(0, 4)
    SmoothFillCorner.Parent = SmoothFill

    -- Color Picker Row
    local ColorLabel = Instance.new("TextLabel")
    ColorLabel.Size = UDim2.new(0, 80, 0, 16)
    ColorLabel.Position = UDim2.new(0, 16, 0, 210)
    ColorLabel.BackgroundTransparency = 1
    ColorLabel.Text = "FOV COLOR"
    ColorLabel.TextColor3 = Color3.fromRGB(130, 130, 140)
    ColorLabel.Font = Enum.Font.GothamBold
    ColorLabel.TextSize = 11
    ColorLabel.TextXAlignment = Enum.TextXAlignment.Left
    ColorLabel.Parent = MainFrame

    local ColorContainer = Instance.new("Frame")
    ColorContainer.Size = UDim2.new(0, 200, 0, 24)
    ColorContainer.Position = UDim2.new(0, 110, 0, 206)
    ColorContainer.BackgroundTransparency = 1
    ColorContainer.Parent = MainFrame
    
    local ColorLayout = Instance.new("UIListLayout")
    ColorLayout.FillDirection = Enum.FillDirection.Horizontal
    ColorLayout.Padding = UDim.new(0, 8)
    ColorLayout.Parent = ColorContainer

    local colors = {
        Color3.fromRGB(88, 166, 255),  -- Claude Blue
        Color3.fromRGB(255, 80, 80),   -- Red
        Color3.fromRGB(80, 255, 120),  -- Green
        Color3.fromRGB(200, 80, 255)   -- Purple
    }

    for _, c in ipairs(colors) do
        local colorBtn = Instance.new("TextButton")
        colorBtn.Size = UDim2.new(0, 24, 0, 24)
        colorBtn.BackgroundColor3 = c
        colorBtn.Text = ""
        colorBtn.BorderSizePixel = 0
        colorBtn.Parent = ColorContainer
        
        local cCorner = Instance.new("UICorner")
        cCorner.CornerRadius = UDim.new(0, 12)
        cCorner.Parent = colorBtn

        colorBtn.MouseButton1Click:Connect(function()
            Settings.Color = c
            FOVStroke.Color = c
            FOVFill.BackgroundColor3 = c
            SmoothFill.BackgroundColor3 = c
            ToggleBtn.TextColor3 = c
            if not Settings.Enabled then ToggleBtn.TextColor3 = Color3.fromRGB(180, 180, 190) end
        end)
    end

    -- Kill Script
    local KillBtn = Instance.new("TextButton")
    KillBtn.Size = UDim2.new(1, -32, 0, 38)
    KillBtn.Position = UDim2.new(0, 16, 0, 250)
    KillBtn.BackgroundColor3 = Color3.fromRGB(50, 26, 26)
    KillBtn.Text = "KILL SCRIPT"
    KillBtn.TextColor3 = Color3.fromRGB(255, 120, 120)
    KillBtn.Font = Enum.Font.GothamBold
    KillBtn.TextSize = 12
    KillBtn.BorderSizePixel = 0
    KillBtn.Parent = MainFrame
    
    local KillCorner = Instance.new("UICorner")
    KillCorner.CornerRadius = UDim.new(0, 8)
    KillCorner.Parent = KillBtn

    -- ============================================================
    -- 4. 交互逻辑
    -- ============================================================
    
    -- F8 开启/关闭面板
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed or isDead then return end
        if input.KeyCode == Enum.KeyCode.F8 then
            MainFrame.Visible = not MainFrame.Visible
        end
    end)

    -- 开关控制
    ToggleBtn.MouseButton1Click:Connect(function()
        if isDead then return end
        Settings.Enabled = not Settings.Enabled
        if Settings.Enabled then
            ToggleBtn.Text = "AIMBOT : ON"
            ToggleBtn.TextColor3 = Settings.Color
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(28, 45, 70)
        else
            ToggleBtn.Text = "AIMBOT : OFF"
            ToggleBtn.TextColor3 = Color3.fromRGB(180, 180, 190)
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 38)
        end
    end)

    -- FOV 滑块
    local draggingFOV = false
    FOVTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingFOV = true end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingFOV = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if isDead or not draggingFOV then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            local pct = math.clamp((input.Position.X - FOVTrack.AbsolutePosition.X) / FOVTrack.AbsoluteSize.X, 0, 1)
            Settings.FOV = 20 + (pct * 280)
            FOVFill.Size = UDim2.new(pct, 0, 1, 0)
            FOVCircle.Size = UDim2.new(0, Settings.FOV * 2, 0, Settings.FOV * 2)
        end
    end)

    -- 平滑度滑块
    local draggingSmooth = false
    SmoothTrack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSmooth = true end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then draggingSmooth = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if isDead or not draggingSmooth then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            local pct = math.clamp((input.Position.X - SmoothTrack.AbsolutePosition.X) / SmoothTrack.AbsoluteSize.X, 0, 1)
            Settings.Smoothness = math.max(0.01, pct)
            SmoothFill.Size = UDim2.new(pct, 0, 1, 0)
        end
    end)

    -- 拖动窗口
    local draggingFrame = false
    local dragStart, startPos
    Title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingFrame = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then draggingFrame = false end
            end)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if isDead or not draggingFrame then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    -- 卸载
    KillBtn.MouseButton1Click:Connect(function()
        isDead = true
        ScreenGui:Destroy()
        FOVGui:Destroy()
    end)
end)

if not success then
    warn("4080 Init Error: " .. tostring(err))
end
