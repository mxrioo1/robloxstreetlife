-- ============================================================
-- Settings
-- ============================================================
local Settings = {
    Enabled = false,
    Strength = 1.0,
    FOV = 200,
    Jitter = 0.1,
}

local targetPos = nil
local targetPart = nil
local isDead = false

-- ============================================================
-- Team Check & Target Acquisition
-- ============================================================
local function isSameTeam(player)
    if not player.Team or not LocalPlayer.Team then return false end
    return player.Team == LocalPlayer.Team
end

local function updateTarget()
    if isDead or not Camera then return end
    
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local bestDist = math.huge
    targetPos = nil
    targetPart = nil

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer or isSameTeam(player) then continue end

        local char = player.Character
        if not char then continue end
        
        local head = char:FindFirstChild("HitboxHead") or char:FindFirstChild("Head")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        
        if not head or not humanoid or humanoid.Health <= 0 then continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then continue end

        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist < bestDist and dist < Settings.FOV then
            bestDist = dist
            targetPos = head.Position
            targetPart = head
        end
    end
end

RunService.PreRender:Connect(updateTarget)

-- ============================================================
-- Trigger: Right Click Aiming + Left Click Shooting
-- ============================================================
local function isShootingAndAiming()
    return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) 
       and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
end

-- ============================================================
-- Metatable Hook (Open-Source Refactored for XENO Compatibility)
-- ============================================================
local mt = getrawmetatable(game)
local oldIndex = mt.__index
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    
    if not checkcaller() and Settings.Enabled and targetPos and isShootingAndAiming() then
        -- 微小手部随机抖动，防止弹道完全重合
        local jitter = Vector3.new(
            (math.random() - 0.5) * Settings.Jitter,
            (math.random() - 0.5) * Settings.Jitter,
            (math.random() - 0.5) * Settings.Jitter
        )
        local aimTarget = targetPos + jitter

        if method == "Raycast" then
            local origin, direction, params = ...
            if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" then
                local aimDir = (aimTarget - origin).Unit * direction.Magnitude
                return oldNamecall(self, origin, direction:Lerp(aimDir, Settings.Strength), params)
            end
        elseif method == "FindPartOnRayWithIgnoreList" then
            local ray, ignoreList, cubes = ...
            if typeof(ray) == "Ray" then
                local aimDir = (aimTarget - ray.Origin).Unit * ray.Direction.Magnitude
                return oldNamecall(self, Ray.new(ray.Origin, ray.Direction:Lerp(aimDir, Settings.Strength)), ignoreList, cubes)
            end
        elseif method == "FindPartOnRayWithWhitelist" then
            local ray, whitelist = ...
            if typeof(ray) == "Ray" then
                local aimDir = (aimTarget - ray.Origin).Unit * ray.Direction.Magnitude
                return oldNamecall(self, Ray.new(ray.Origin, ray.Direction:Lerp(aimDir, Settings.Strength)), whitelist)
            end
        elseif method == "FindPartOnRay" then
            local ray, ignoreDesc, cubes = ...
            if typeof(ray) == "Ray" then
                local aimDir = (aimTarget - ray.Origin).Unit * ray.Direction.Magnitude
                return oldNamecall(self, Ray.new(ray.Origin, ray.Direction:Lerp(aimDir, Settings.Strength)), ignoreDesc, cubes)
            end
        end
    end
    return oldNamecall(self, ...)
end)

mt.__index = newcclosure(function(self, key)
    if not checkcaller() and Settings.Enabled and targetPos and isShootingAndAiming() and self == Mouse then
        if key == "Hit" then
            local jitter = Vector3.new(
                (math.random() - 0.5) * Settings.Jitter,
                (math.random() - 0.5) * Settings.Jitter,
                (math.random() - 0.5) * Settings.Jitter
            )
            local aimTarget = targetPos + jitter
            local look = CFrame.lookAt(Camera.CFrame.Position, aimTarget)
            return CFrame.new(aimTarget) * look.Rotation
        elseif key == "Target" then
            return targetPart
        end
    end
    return oldIndex(self, key)
end)

setreadonly(mt, true)

