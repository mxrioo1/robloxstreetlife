-- ============================================================
-- Safe Target Acquisition
-- ============================================================
local function isSameTeam(player)
    if not player.Team or not LocalPlayer.Team then return false end
    return player.Team == LocalPlayer.Team
end

local function updateTarget()
    if isDead or not Camera then return end
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local bestDist = math.huge
    targetPos = nil

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer or isSameTeam(player) then continue end
        local char = player.Character
        if not char then continue end
        
        local head = char:FindFirstChild("HitboxHead") or char:FindFirstChild("Head")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not head or not hum or hum.Health <= 0 then continue end

        local sp, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then continue end

        local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if dist < bestDist and dist < Settings.FOV then
            bestDist = dist
            targetPos = head.Position
        end
    end
end

RunService.PreRender:Connect(updateTarget)

-- ============================================================
-- Trigger & Safe API Wrappers
-- ============================================================
local function isAimFire()
    return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
       and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
end

local function safeGetMethod()
    if getnamecallmethod then
        local success, m = pcall(getnamecallmethod)
        if success then return m end
    end
    return ""
end

local function safeIsCaller()
    if checkcaller then
        local success, c = pcall(checkcaller)
        if success then return c end
    end
    return false
end

-- ============================================================
-- Crash-Proof Hook Installation
-- ============================================================
local hookSuccess = pcall(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        if safeIsCaller() or not Settings.Enabled or not targetPos or not isAimFire() or not oldNamecall then
            return oldNamecall and oldNamecall(self, ...) or nil
        end

        local method = safeGetMethod()
        
        local jitter = Vector3.new(
            (math.random() - 0.5) * Settings.Jitter,
            (math.random() - 0.5) * Settings.Jitter,
            (math.random() - 0.5) * Settings.Jitter
        )
        local aim = targetPos + jitter

        if method == "Raycast" then
            local origin, dir, params = ...
            if typeof(origin) == "Vector3" and typeof(dir) == "Vector3" then
                local newDir = (aim - origin).Unit * dir.Magnitude
                return oldNamecall(self, origin, dir:Lerp(newDir, Settings.Strength), params)
            end
        elseif method == "FindPartOnRayWithIgnoreList" then
            local ray, ignore, cubes = ...
            if typeof(ray) == "Ray" then
                local newDir = (aim - ray.Origin).Unit * ray.Direction.Magnitude
                return oldNamecall(self, Ray.new(ray.Origin, ray.Direction:Lerp(newDir, Settings.Strength)), ignore, cubes)
            end
        elseif method == "FindPartOnRayWithWhitelist" then
            local ray, white = ...
            if typeof(ray) == "Ray" then
                local newDir = (aim - ray.Origin).Unit * ray.Direction.Magnitude
                return oldNamecall(self, Ray.new(ray.Origin, ray.Direction:Lerp(newDir, Settings.Strength)), white)
            end
        elseif method == "FindPartOnRay" then
            local ray, ignoreDesc = ...
            if typeof(ray) == "Ray" then
                local newDir = (aim - ray.Origin).Unit * ray.Direction.Magnitude
                return oldNamecall(self, Ray.new(ray.Origin, ray.Direction:Lerp(newDir, Settings.Strength)), ignoreDesc)
            end
        end
        return oldNamecall(self, ...)
    end)

    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, key)
        if safeIsCaller() or not Settings.Enabled or not targetPos or not isAimFire() or not oldIndex then
            return oldIndex and oldIndex(self, key) or nil
        end
        if self == Mouse then
            if key == "Hit" then
                local jitter = Vector3.new(
                    (math.random() - 0.5) * Settings.Jitter,
                    (math.random() - 0.5) * Settings.Jitter,
                    (math.random() - 0.5) * Settings.Jitter
                )
                local aim = targetPos + jitter
                local look = CFrame.lookAt(Camera.CFrame.Position, aim)
                return CFrame.new(aim) * look.Rotation
            elseif key == "Target" then
                return Workspace:FindPartOnRay(Ray.new(Camera.CFrame.Position, (targetPos - Camera.CFrame.Position).Unit * 1000))
            end
        end
        return oldIndex(self, key)
    end)
end)

if not hookSuccess then
    warn("Silent Aim: Hook failed on this executor.")
end

