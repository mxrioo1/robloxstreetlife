-- 拖动滑块 (真实鼠标拖动)
local draggingSlider = false

StrengthBar.InputBegan:Connect(function(input)
    if isDead then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingSlider = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingSlider = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDead then return end
    if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
        local percent = math.clamp((input.Position.X - StrengthBar.AbsolutePosition.X) / StrengthBar.AbsoluteSize.X, 0, 1)
        Settings.Strength = percent
        StrengthFill.Size = UDim2.new(percent, 0, 1, 0)
    end
end)

-- 拖动窗口
local draggingFrame = false
local dragStart, startPos

TitleBar.InputBegan:Connect(function(input)
    if isDead then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingFrame = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                draggingFrame = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDead then return end
    if draggingFrame and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

