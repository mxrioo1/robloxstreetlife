-- ============================================================
-- 依赖模块 (采用安全的 pcall 获取，防止游戏更新导致脚本崩溃)
-- ============================================================
local function safeRequire(parent, name)
    local obj = parent:FindFirstChild(name, true)
    if obj then
        local success, result = pcall(require, obj)
        if success then return result end
    end
    return nil
end

local neuron = safeRequire(ReplicatedFirst, "neuron")
local States = safeRequire(ReplicatedStorage, "States")
