local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- Settings
local Settings = {
    Enabled = false,
    Strength = 1.0, -- 1.0 = full redirect, lower = softer
}

-- Team check
local function isSameTeam(player)
    if not player.Team or not LocalPlayer.Team then
        return false
    end
    return player.Team == LocalPlayer.Team
end

-- Modules required by the game
local neuron = require(ReplicatedFirst:FindFirstChild("neuron", true))
local States = require(ReplicatedStorage:FindFirstChild("States", true))
local GenerateCommand = require(ReplicatedFirst:FindFirstChild("GenerateCommand", true))
local CameraHandler = require(ReplicatedStorage:FindFirstChild("CameraHandler", true))
local Effects = require(ReplicatedStorage:FindFirstChild("Effects", true))

-- Target cache
local targetPos = nil

-- Find closest enemy head (skips teammates)
local function findTarget()
    local entitiesFolder = Workspace:FindFirstChild("Entities", true)
    if not entitiesFolder then
        return
    end

    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local bestDist = 9e9

    -- Players
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then
            continue
        end
        if isSameTeam(player) then
            continue
        end

        local char = neuron:get_character(player)
        if not char then
            continue
        end

        local head = char:FindFirstChild("HitboxHead")
        if not head then
            continue
        end

        if States:GetStateValue(char, "Dead", false) then
            continue
        end

        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then
            continue
        end

        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist < bestDist then
            bestDist = dist
            targetPos = head.Position
        end
    end

    -- NPCs / entities (no team check applies)
    for _, entity in ipairs(entitiesFolder:GetChildren()) do
        local head = entity:FindFirstChild("HitboxHead")
        if not head then
            continue
        end

        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then
            continue
        end

        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist < bestDist then
            bestDist = dist
            targetPos = head.Position
        end
    end
end

-- Update target every frame
RunService.PreRender:Connect(findTarget)

-- Hook 1: Camera angles (used by game for shot direction)
local oldGetCameraAngles
oldGetCameraAngles = hookfunction(GenerateCommand.GetCameraAngles, newlclosure(function(...)
    if not CameraHandler.firstPerson then
        return oldGetCameraAngles(...)
    end
    local current = CameraHandler.currentRotation
    return current.X, current.Y
end))

-- Hook 2: Effects.Identify — this is where the bullet hit position is redirected
local oldIdentify
oldIdentify = hookfunction(Effects.Identify, newlclosure(function(self, effectType, ...)
    local args = { ... }
    local origin = args.origin
    local hitPos = args.hitPos

    if Settings.Enabled and targetPos and effectType == "Shot" and origin and hitPos then
        local originalDist = (hitPos - origin).Magnitude
        local directionToTarget = (targetPos - origin).Unit
        local newHitPos = origin + directionToTarget * originalDist

        -- Strength: lerp between original hitPos and redirected position
        args.hitPos = hitPos:Lerp(newHitPos, Settings.Strength)
    end

    return oldIdentify(self, effectType, table.unpack(args))
end))

