-- ============================================================
-- Settings
-- ============================================================
local Settings = {
    Enabled = false,
    Strength = 1.0,   -- 1.0 = full head snap, 0.0 = original shot
}

-- ============================================================
-- Target cache
-- ============================================================
local targetPos = nil

local function isSameTeam(player)
    if not player.Team or not LocalPlayer.Team then return false end
    return player.Team == LocalPlayer.Team
end

local function updateTarget()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local bestDist = math.huge
    targetPos = nil

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if isSameTeam(player) then continue end

        local char = player.Character
        if not char then continue end

        local head = char:FindFirstChild("Head")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not head or not humanoid or humanoid.Health <= 0 then continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then continue end

        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist < bestDist then
            bestDist = dist
            targetPos = head.Position
        end
    end
end

RunService.PreRender:Connect(updateTarget)

-- ============================================================
-- Namecall hook for all ray methods
-- ============================================================
local mt = getrawmetatable(game)
local oldNamecall = mt.__namecall
setreadonly(mt, false)

mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()

    if Settings.Enabled and targetPos and (method == "Raycast"
        or method == "FindPartOnRayWithIgnoreList"
        or method == "FindPartOnRayWithWhitelist"
        or method == "FindPartOnRay") then

        local args = table.pack(...)

        -- Raycast(origin, direction, params) -> redirect direction
        if method == "Raycast" and args.n >= 2 then
            local origin = args[1]
            local direction = args[2]
            if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" then
                local aimDir = (targetPos - origin).Unit * direction.Magnitude
                args[2] = direction:Lerp(aimDir, Settings.Strength)
                return oldNamecall(self, table.unpack(args, 1, args.n))
            end
        end

        -- FindPartOnRayWithIgnoreList(ray, ignoreList, ...)
        if method == "FindPartOnRayWithIgnoreList" and args.n >= 1 then
            local ray = args[1]
            if typeof(ray) == "Ray" then
                local aimDir = (targetPos - ray.Origin).Unit * ray.Direction.Magnitude
                local newRay = Ray.new(ray.Origin, ray.Direction:Lerp(aimDir, Settings.Strength))
                args[1] = newRay
                return oldNamecall(self, table.unpack(args, 1, args.n))
            end
        end

        -- FindPartOnRayWithWhitelist(ray, whitelist, ...)
        if method == "FindPartOnRayWithWhitelist" and args.n >= 1 then
            local ray = args[1]
            if typeof(ray) == "Ray" then
                local aimDir = (targetPos - ray.Origin).Unit * ray.Direction.Magnitude
                local newRay = Ray.new(ray.Origin, ray.Direction:Lerp(aimDir, Settings.Strength))
                args[1] = newRay
                return oldNamecall(self, table.unpack(args, 1, args.n))
            end
        end

        -- FindPartOnRay(ray, ignoreDescendantsInstance, ...)
        if method == "FindPartOnRay" and args.n >= 1 then
            local ray = args[1]
            if typeof(ray) == "Ray" then
                local aimDir = (targetPos - ray.Origin).Unit * ray.Direction.Magnitude
                local newRay = Ray.new(ray.Origin, ray.Direction:Lerp(aimDir, Settings.Strength))
                args[1] = newRay
                return oldNamecall(self, table.unpack(args, 1, args.n))
            end
        end
    end

    return oldNamecall(self, ...)
end)

setreadonly(mt, true)

-- ============================================================
-- Mouse fallback (for games still using Mouse.Hit / Mouse.Target)
-- ============================================================
local oldIndex = mt.__index

mt.__index = newcclosure(function(self, key)
    if Settings.Enabled and targetPos and self == Mouse then
        if key == "Hit" then
            local look = CFrame.lookAt(Camera.CFrame.Position, targetPos)
            return CFrame.new(targetPos) * (look - look.Position)
        elseif key == "Target" then
            return Workspace:FindPartOnRay(Ray.new(Camera.CFrame.Position,
                (targetPos - Camera.CFrame.Position).Unit * 1000))
        end
    end
    return oldIndex(self, key)
end)

