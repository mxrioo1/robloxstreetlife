-- ============================================================
-- Interactions
-- ============================================================
UserInputService.InputBegan:Connect(function(input, processed)
    if processed or isDead then return end
    if input.KeyCode == Enum.KeyCode.F8 then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

ToggleBtn.MouseButton1Click:Connect(function()
    if isDead then return end
    Settings.Enabled = not Settings.Enabled
    ToggleBtn.Text = Settings.Enabled and "SILENT: ON" or "SILENT: OFF"
    ToggleBtn.TextColor3 = Settings.Enabled and Color3.fromRGB(0, 255, 120) or Color3.fromRGB(150, 150, 150)
    ToggleBtn.BackgroundColor3 = Settings.Enabled and Color3.fromRGB(0, 50, 25) or Color3.fromRGB(30, 30, 30)
end)

local draggingSlider = false

StrengthBar.InputBegan:Connect(function(input)
    if isDead then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingSlider = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingSlider = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDead then return end
    if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
        local percent = math.clamp((input.Position.X - StrengthBar.AbsolutePosition.X) / StrengthBar.AbsoluteSize.X, 0, 1)
        Settings.Strength = percent
        StrengthFill.Size = UDim2.new(percent, 0, 1, 0)
    end
end)

local draggingFrame = false
local dragStart, startPos

TitleBar.InputBegan:Connect(function(input)
    if isDead then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingFrame = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                draggingFrame = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDead then return end
    if draggingFrame and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

KillBtn.MouseButton1Click:Connect(function()
    isDead = true
    ScreenGui:Destroy()
end)
