-- ratman4080 silent aim v16 | Remote & Ray debugger
-- Prints a red ESP box over the target so you know it's working.

local success, err = pcall(function()
    print("sit activated")

    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService")
    local Workspace = game:GetService("Workspace")

    local LocalPlayer = Players.LocalPlayer
    local Camera = Workspace.CurrentCamera
    local Mouse = LocalPlayer:GetMouse()

    getgenv().Settings = getgenv().Settings or { 
        Enabled = false, 
        Strength = 1.0, 
        FOV = 250, 
        Jitter = 0.05,
        IsAiming = false,
        IsFiring = false
    }
    local Settings = getgenv().Settings
    local targetPos = nil
    local targetPart = nil
    local isDead = false

    -- 监听鼠标状态
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then Settings.IsFiring = true end
        if input.UserInputType == Enum.UserInputType.MouseButton2 then Settings.IsAiming = true end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then Settings.IsFiring = false end
        if input.UserInputType == Enum.UserInputType.MouseButton2 then Settings.IsAiming = false end
    end)

    -- 目标获取 (带调试框)
    local debugBox = Instance.new("BoxHandleAdornment")
    debugBox.Size = Vector3.new(2, 2, 2)
    debugBox.Color3 = Color3.fromRGB(255, 50, 50)
    debugBox.Transparency = 0.5
    debugBox.AlwaysOnTop = true
    debugBox.Adornee = nil
    debugBox.Parent = game:GetService("CoreGui")

    local function updateTarget()
        if isDead or not Camera then return end
        local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local bestDist = math.huge
        targetPos = nil
        targetPart = nil

        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer or (player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team) then continue end
            local char = player.Character
            if not char then continue end
            
            local head = char:FindFirstChild("HitboxHead") or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not head or not hum or hum.Health <= 0 then continue end

            local sp, onScreen = Camera:WorldToViewportPoint(head.Position)
            if not onScreen then continue end

            local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
            if dist < bestDist and dist < Settings.FOV then
                bestDist = dist
                targetPos = head.Position
                targetPart = head
            end
        end

        -- 更新调试框
        if targetPart then
            debugBox.Adornee = targetPart
        else
            debugBox.Adornee = nil
        end
    end

    RunService.PreRender:Connect(function()
        pcall(updateTarget)
    end)

    -- 核心 Hook
    local hookSuccess = false
    
    pcall(function()
        local mt = getrawmetatable(game)
        if mt then
            local oldNamecall = mt.__namecall
            local oldIndex = mt.__index
            setreadonly(mt, false)
            
            -- 拦截所有可能的射线和开火事件
            mt.__namecall = newcclosure(function(self, ...)
                local method = getnamecallmethod()
                if not method or not Settings.Enabled or not targetPos or not Settings.IsAiming or not Settings.IsFiring then
                    return oldNamecall(self, ...)
                end
                
                local jitter = Vector3.new((math.random()-0.5)*Settings.Jitter, (math.random()-0.5)*Settings.Jitter, (math.random()-0.5)*Settings.Jitter)
                local aim = targetPos + jitter

                -- 传统射线
                if method == "Raycast" then
                    local origin, dir, params = ...
                    if typeof(origin) == "Vector3" and typeof(dir) == "Vector3" then
                        return oldNamecall(self, origin, dir:Lerp((aim - origin).Unit * dir.Magnitude, Settings.Strength), params)
                    end
                elseif method == "FindPartOnRayWithIgnoreList" then
                    local ray, ignore, cubes = ...
                    if typeof(ray) == "Ray" then
                        return oldNamecall(self, Ray.new(ray.Origin, ray.Direction:Lerp((aim - ray.Origin).Unit * ray.Direction.Magnitude, Settings.Strength)), ignore, cubes)
                    end
                elseif method == "ScreenPointToRay" then
                    -- 有些游戏用摄像机发射
                    if self == Camera then
                        local x, y, depth = ...
                        local newRay = Ray.new(Camera.CFrame.Position, (aim - Camera.CFrame.Position).Unit * 1000)
                        return newRay
                    end
                elseif method == "FireServer" then
                    -- 拦截 RemoteEvent：寻找参数里的位置或方向并修改
                    local args = table.pack(...)
                    for i = 1, args.n do
                        local arg = args[i]
                        if typeof(arg) == "CFrame" then
                            args[i] = CFrame.lookAt(arg.Position, aim)
                        elseif typeof(arg) == "Vector3" then
                            -- 很多时候第一个向量是起点，第二个是终点/方向
                            if i == 1 then
                                args[i] = aim
                            end
                        elseif typeof(arg) == "Ray" then
                            args[i] = Ray.new(arg.Origin, (aim - arg.Origin).Unit * arg.Direction.Magnitude)
                        end
                    end
                    return oldNamecall(self, table.unpack(args, 1, args.n))
                end
                
                return oldNamecall(self, ...)
            end)
            
            -- 拦截 Mouse.Hit 和 Mouse.UnitRay
            mt.__index = newcclosure(function(self, key)
                if not oldIndex then return nil end
                if Settings.Enabled and targetPos and Settings.IsAiming and Settings.IsFiring then
                    if self == Mouse then
                        if key == "Hit" then
                            local aim = targetPos
                            local look = CFrame.lookAt(Camera.CFrame.Position, aim)
                            return CFrame.new(aim) * look.Rotation
                        elseif key == "UnitRay" then
                            return Ray.new(Camera.CFrame.Position, (targetPos - Camera.CFrame.Position).Unit * 1000)
                        end
                    end
                end
                return oldIndex(self, key)
            end)
            
            setreadonly(mt, true)
            hookSuccess = true
        end
    end)

    -- 构建 UI
    local guiParent = (gethui and gethui()) or game:GetService("CoreGui")
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "4080_SA_v16"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.Parent = guiParent
    
    local MainFrame = Instance.new("Frame")
    MainFrame.Size = UDim2.new(0, 300, 0, 230)
    MainFrame.Position = UDim2.new(0.5, -150, 0.5, -115)
    MainFrame.BackgroundColor3 = Color3.fromRGB(22, 22, 26)
    MainFrame.BorderSizePixel = 0
    MainFrame.Visible = false
    MainFrame.Parent = ScreenGui
    
    local MainCorner = Instance.new("UICorner")
    MainCorner.CornerRadius = UDim.new(0, 12)
    MainCorner.Parent = MainFrame
    
    local MainStroke = Instance.new("UIStroke")
    MainStroke.Color = Color3.fromRGB(45, 45, 52)
    MainStroke.Thickness = 1
    MainStroke.Parent = MainFrame
    
    local Title = Instance.new("TextLabel")
    Title.Size = UDim2.new(1, -32, 0, 24)
    Title.Position = UDim2.new(0, 16, 0, 16)
    Title.BackgroundTransparency = 1
    Title.Text = "4080 · SILENT AIM"
    Title.TextColor3 = Color3.fromRGB(235, 235, 240)
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 15
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.Parent = MainFrame
    
    local Subtitle = Instance.new("TextLabel")
    Subtitle.Size = UDim2.new(1, -32, 0, 16)
    Subtitle.Position = UDim2.new(0, 16, 0, 38)
    Subtitle.BackgroundTransparency = 1
    Subtitle.Text = "Hold Right Click + Left Click"
    Subtitle.TextColor3 = Color3.fromRGB(140, 140, 150)
    Subtitle.Font = Enum.Font.Gotham
    Subtitle.TextSize = 11
    Subtitle.TextXAlignment = Enum.TextXAlignment.Left
    Subtitle.Parent = MainFrame
    
    local Div = Instance.new("Frame")
    Div.Size = UDim2.new(1, -32, 0, 1)
    Div.Position = UDim2.new(0, 16, 0, 62)
    Div.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
    Div.BorderSizePixel = 0
    Div.Parent = MainFrame
    
    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Size = UDim2.new(1, -32, 0, 36)
    ToggleBtn.Position = UDim2.new(0, 16, 0, 76)
    ToggleBtn.BackgroundColor3 = Settings.Enabled and Color3.fromRGB(28, 45, 70) or Color3.fromRGB(32, 32, 38)
    ToggleBtn.Text = Settings.Enabled and "SILENT AIM : ON" or "SILENT AIM : OFF"
    ToggleBtn.TextColor3 = Settings.Enabled and Color3.fromRGB(88, 166, 255) or Color3.fromRGB(180, 180, 190)
    ToggleBtn.Font = Enum.Font.GothamSemibold
    ToggleBtn.TextSize = 12
    ToggleBtn.BorderSizePixel = 0
    ToggleBtn.Parent = MainFrame
    
    local ToggleCorner = Instance.new("UICorner")
    ToggleCorner.CornerRadius = UDim.new(0, 8)
    ToggleCorner.Parent = ToggleBtn
    
    local StrengthLabel = Instance.new("TextLabel")
    StrengthLabel.Size = UDim2.new(0, 80, 0, 16)
    StrengthLabel.Position = UDim2.new(0, 16, 0, 128)
    StrengthLabel.BackgroundTransparency = 1
    StrengthLabel.Text = "STRENGTH"
    StrengthLabel.TextColor3 = Color3.fromRGB(130, 130, 140)
    StrengthLabel.Font = Enum.Font.GothamBold
    StrengthLabel.TextSize = 10
    StrengthLabel.TextXAlignment = Enum.TextXAlignment.Left
    StrengthLabel.Parent = MainFrame
    
    local Track = Instance.new("Frame")
    Track.Size = UDim2.new(0, 170, 0, 8)
    Track.Position = UDim2.new(0, 100, 0, 132)
    Track.BackgroundColor3 = Color3.fromRGB(40, 40, 46)
    Track.BorderSizePixel = 0
    Track.Parent = MainFrame
    
    local TrackCorner = Instance.new("UICorner")
    TrackCorner.CornerRadius = UDim.new(0, 4)
    TrackCorner.Parent = Track
    
    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new(Settings.Strength, 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(88, 166, 255)
    Fill.BorderSizePixel = 0
    Fill.Parent = Track
    
    local FillCorner = Instance.new("UICorner")
    FillCorner.CornerRadius = UDim.new(0, 4)
    FillCorner.Parent = Fill
    
    local KillBtn = Instance.new("TextButton")
    KillBtn.Size = UDim2.new(1, -32, 0, 34)
    KillBtn.Position = UDim2.new(0, 16, 0, 170)
    KillBtn.BackgroundColor3 = Color3.fromRGB(50, 26, 26)
    KillBtn.Text = "KILL SCRIPT"
    KillBtn.TextColor3 = Color3.fromRGB(255, 120, 120)
    KillBtn.Font = Enum.Font.GothamBold
    KillBtn.TextSize = 11
    KillBtn.BorderSizePixel = 0
    KillBtn.Parent = MainFrame
    
    local KillCorner = Instance.new("UICorner")
    KillCorner.CornerRadius = UDim.new(0, 8)
    KillCorner.Parent = KillBtn
    
    -- 交互
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed or isDead then return end
        if input.KeyCode == Enum.KeyCode.F8 then
            MainFrame.Visible = not MainFrame.Visible
        end
    end)
    
    ToggleBtn.MouseButton1Click:Connect(function()
        if isDead then return end
        Settings.Enabled = not Settings.Enabled
        if Settings.Enabled then
            ToggleBtn.Text = "SILENT AIM : ON"
            ToggleBtn.TextColor3 = Color3.fromRGB(88, 166, 255)
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(28, 45, 70)
        else
            ToggleBtn.Text = "SILENT AIM : OFF"
            ToggleBtn.TextColor3 = Color3.fromRGB(180, 180, 190)
            ToggleBtn.BackgroundColor3 = Color3.fromRGB(32, 32, 38)
        end
    end)
    
    local draggingSlider = false
    Track.InputBegan:Connect(function(input)
        if isDead then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingSlider = true
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingSlider = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if isDead or not draggingSlider then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            local pct = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
            Settings.Strength = pct
            Fill.Size = UDim2.new(pct, 0, 1, 0)
        end
    end)
    
    local draggingFrame = false
    local dragStart, startPos
    Title.InputBegan:Connect(function(input)
        if isDead then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingFrame = true
            dragStart = input.Position
            startPos = MainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    draggingFrame = false
                end
            end)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if isDead or not draggingFrame then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    
    KillBtn.MouseButton1Click:Connect(function()
        isDead = true
        if debugBox then debugBox:Destroy() end
        ScreenGui:Destroy()
    end)
end)

if not success then
    warn("4080 Init Error: " .. tostring(err))
end
