    if processed or isDead then return end
    if input.KeyCode == Enum.KeyCode.F8 then
        Card.Visible = not Card.Visible
    end
end)

-- Toggle
ToggleBtn.MouseButton1Click:Connect(function()
    if isDead then return end
    Settings.Enabled = not Settings.Enabled
    ToggleBtn.Text = Settings.Enabled and "SILENT AIM  ·  ON" or "SILENT AIM  ·  OFF"
    ToggleBtn.TextColor3 = Settings.Enabled and Color3.fromRGB(88, 166, 255) or Color3.fromRGB(170, 170, 180)
    ToggleBtn.BackgroundColor3 = Settings.Enabled and Color3.fromRGB(28, 45, 70) or Color3.fromRGB(32, 32, 38)
end)

-- Slider: drag on track
local draggingSlider = false

Track.InputBegan:Connect(function(input)
    if isDead then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingSlider = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingSlider = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDead or not draggingSlider then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        local pct = math.clamp(
            (input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X,
            0, 1
        )
        Settings.Strength = pct
        Fill.Size = UDim2.new(pct, 0, 1, 0)
    end
end)

-- Window drag on header
local draggingCard = false
local dragStart, startPos

Header.InputBegan:Connect(function(input)
    if isDead then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingCard = true
        dragStart = input.Position
        startPos = Card.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                draggingCard = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDead or not draggingCard then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        Card.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

